[
  {
    "file": "assets/audio/ms-MY/a3192f839d091a21a0.mp3",
    "text": "Soalan 1. Rokok mengandungi bahan apa?",
    "seconds": 5.86,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/379cddffe8f5370c56.mp3",
    "text": "Pilihan A. Alkohol",
    "seconds": 3.02,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/8eb8239f043d35c3b5.mp3",
    "text": "Pilihan B. Tembakau",
    "seconds": 3.17,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/807dd9031bd19d62cf.mp3",
    "text": "Pilihan C. Gula",
    "seconds": 2.78,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/a0dcf1c6c0f296253b.mp3",
    "text": "Fikir tentang daun yang digunakan dalam rokok.",
    "seconds": 4.56,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/85b51be405bfc1bc52.mp3",
    "text": "Betul! Rokok mengandungi tembakau. Jauhi rokok dan asapnya.",
    "seconds": 8.71,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/c82fd91b298074ad0f.mp3",
    "text": "Soalan 2. Apakah bahan yang dinyatakan pada label minuman ini?",
    "seconds": 7.18,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/ebe393e7413fb1a426.mp3",
    "text": "Pilihan A. Susu",
    "seconds": 2.81,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/efca0b02da5cf5ae15.mp3",
    "text": "Pilihan B. Jus buah",
    "seconds": 3.12,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/552a4bf9a4edbe043c.mp3",
    "text": "Pilihan C. Alkohol",
    "seconds": 3.12,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/f5ed77d68c3a45597c.mp3",
    "text": "Baca perkataan pada label minuman.",
    "seconds": 3.91,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/3dfa7110be6fcda78c.mp3",
    "text": "Tepat! Label itu menyatakan alkohol. Pilih minuman yang selamat seperti air kosong.",
    "seconds": 9.84,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/9fe38c2b0c6147ac55.mp3",
    "text": "Soalan 3. Yang manakah bahan ketagihan?",
    "seconds": 5.88,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/81654f750fb501cd5f.mp3",
    "text": "Pilihan A. Dadah terlarang",
    "seconds": 3.36,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/630e89ffd978529162.mp3",
    "text": "Pilihan B. Air kosong",
    "seconds": 3.41,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/a4a614541bf0bca524.mp3",
    "text": "Pilihan C. Buah-buahan",
    "seconds": 3.36,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/a9d2547615009db686.mp3",
    "text": "Air kosong dan buah-buahan ialah pilihan untuk menjaga kesihatan.",
    "seconds": 5.81,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/614bbf688e1a95102c.mp3",
    "text": "Betul! Dadah terlarang ialah bahan ketagihan yang perlu dijauhi. Ubat mengikut arahan doktor berbeza daripada dadah terlarang.",
    "seconds": 12.43,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/60af1188f820079611.mp3",
    "text": "Soalan 4. Pilih kumpulan yang mengandungi tiga bahan ketagihan.",
    "seconds": 7.2,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/baac33021e8f9ee1bf.mp3",
    "text": "Pilihan A. Tembakau, susu dan dadah",
    "seconds": 4.97,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/bda2203ade4f20f43d.mp3",
    "text": "Pilihan B. Tembakau, alkohol dan dadah",
    "seconds": 5.04,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/e51a8bf8b77f278cf0.mp3",
    "text": "Pilihan C. Alkohol, air kosong dan tembakau",
    "seconds": 5.45,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/adee1502f0bda5adef.mp3",
    "text": "Susu dan air kosong bukan bahan ketagihan.",
    "seconds": 4.54,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/e2be717754db6b25dc.mp3",
    "text": "Tepat! Tembakau, alkohol dan dadah ialah tiga bahan ketagihan yang kita pelajari.",
    "seconds": 8.71,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/432c561e02e2f48abd.mp3",
    "text": "Soalan 1. Kelaskan tiga bukti ini.",
    "seconds": 5.76,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/933022fdb479233c22.mp3",
    "text": "Rokok",
    "seconds": 2.02,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/5104a5160d6af4c12f.mp3",
    "text": "Minuman berlabel alkohol",
    "seconds": 3.26,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/63ac79bac46107b4a3.mp3",
    "text": "Poster “Jauhi Dadah Terlarang”",
    "seconds": 3.36,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/4c0419be855b56be57.mp3",
    "text": "Tembakau",
    "seconds": 2.3,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/d65343edaf547f6be2.mp3",
    "text": "Alkohol",
    "seconds": 2.33,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/a7256c347af980e3e8.mp3",
    "text": "Dadah",
    "seconds": 1.92,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/c78617dbcfc4fb7b67.mp3",
    "text": "Lihat gambar dan baca label setiap kad.",
    "seconds": 4.27,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/bdf599c477af5dad58.mp3",
    "text": "Bagus! Rokok dipadankan dengan tembakau, minuman berlabel dengan alkohol, dan poster dengan dadah terlarang.",
    "seconds": 10.44,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/8cbea42752e29ea0c7.mp3",
    "text": "Soalan 2. Padankan tanda dengan maksudnya.",
    "seconds": 6.02,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/f83958d47f947a037f.mp3",
    "text": "Simbol dilarang merokok",
    "seconds": 3.05,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/a2c69873ece0c775f5.mp3",
    "text": "Papan “Jauhi Alkohol”",
    "seconds": 3.02,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/d8fb46e7ac1dd1250c.mp3",
    "text": "Papan “Jauhi Dadah”",
    "seconds": 2.62,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/accb3ad324494cf77e.mp3",
    "text": "Jangan merokok di kawasan ini",
    "seconds": 3.65,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/ffa4b915483c4ca1c1.mp3",
    "text": "Elakkan minuman beralkohol",
    "seconds": 3.46,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/b5eef5583b3c45c0bb.mp3",
    "text": "Jauhi dadah terlarang",
    "seconds": 3.05,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/c6fe9d4cdc05d13aff.mp3",
    "text": "Perhatikan simbol dan perkataan pada papan.",
    "seconds": 4.46,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/044a3e605bf2ef6db5.mp3",
    "text": "Tepat! Tanda larangan mengingatkan kita supaya menjauhi bahan ketagihan.",
    "seconds": 7.51,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/63add3909711d0e889.mp3",
    "text": "Soalan 3. Padankan situasi dengan tindakan selamat.",
    "seconds": 6.53,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/4f84c089cb83a3180d.mp3",
    "text": "Kawasan berasap rokok",
    "seconds": 3.14,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/386938a3e5b023a89e.mp3",
    "text": "Ditawarkan minuman beralkohol",
    "seconds": 3.72,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/059ee9464a64356c8d.mp3",
    "text": "Menemui bungkusan tidak dikenali",
    "seconds": 3.65,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/fa60a91aa92dd40839.mp3",
    "text": "Pilih laluan lain",
    "seconds": 2.81,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/187a81e970c13ce9df.mp3",
    "text": "Tolak pelawaan",
    "seconds": 2.64,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/d78c9b835b7be8456d.mp3",
    "text": "Jangan sentuh dan beritahu guru",
    "seconds": 3.72,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/449e42ea1155fa8714.mp3",
    "text": "Fikir cara menjauhkan diri daripada setiap risiko.",
    "seconds": 5.02,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/fb874097b9d52c7b76.mp3",
    "text": "Betul! Pilih laluan bersih, tolak pelawaan dan minta bantuan. Kita tidak mengetahui isi bungkusan hanya daripada rupanya.",
    "seconds": 12.91,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/fd88de7a0b22a60ce4.mp3",
    "text": "Soalan 4. Padankan tindakan dengan tujuannya.",
    "seconds": 6.17,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/a96d0ab4415cff5c2e.mp3",
    "text": "Berkata “TIDAK”",
    "seconds": 2.35,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/bd2b56fe9eed2c5cd0.mp3",
    "text": "Beredar ke tempat selamat",
    "seconds": 2.98,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/66d5b485c8b159e35c.mp3",
    "text": "Memberitahu guru atau penjaga",
    "seconds": 3.65,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/8f2dbaa1a55725b9ed.mp3",
    "text": "Menolak pelawaan",
    "seconds": 2.78,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/79060bab56afa0b75f.mp3",
    "text": "Menjauhkan diri daripada bahaya",
    "seconds": 3.72,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/67f6028c3d73273878.mp3",
    "text": "Mendapatkan bantuan",
    "seconds": 2.98,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/5d7768beb23887d2d0.mp3",
    "text": "Fikir sebab kita melakukan setiap tindakan.",
    "seconds": 4.7,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/3bae2a2155d530bbe5.mp3",
    "text": "Hebat! Menolak, beredar dan memberitahu orang dewasa membantu kita menjaga keselamatan.",
    "seconds": 8.95,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/e97f9518529cdcfeaf.mp3",
    "text": "Soalan 1. Rakan mengajak kamu mencuba rokok.",
    "seconds": 6.31,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/39150e1147b4d3f430.mp3",
    "text": "Saya",
    "seconds": 2.11,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/feec7b5ba0945017fa.mp3",
    "text": "menolak pelawaan itu",
    "seconds": 3.1,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/ec4f2dbb3b14009555.mp3",
    "text": "dan",
    "seconds": 1.9,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/e67a4858988437654e.mp3",
    "text": "memberitahu guru.",
    "seconds": 2.71,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/cc54f2bf6b80063fa8.mp3",
    "text": "mencuba rokok itu",
    "seconds": 2.86,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/f99bb83b1c7094b508.mp3",
    "text": "Mulakan dengan siapa yang bertindak. Pilih tindakan menolak dan mendapatkan bantuan.",
    "seconds": 8.45,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/3b8b92fc7686b47528.mp3",
    "text": "Saya menolak pelawaan itu dan memberitahu guru. Beredar juga ke tempat selamat.",
    "seconds": 8.04,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/d42eba50aade892d01.mp3",
    "text": "Soalan 2. Seseorang menawarkan minuman beralkohol.",
    "seconds": 6.6,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/c729e5e1e09089d1dc.mp3",
    "text": "menolak minuman itu",
    "seconds": 3.05,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/2208996c4ea91a9188.mp3",
    "text": "beredar.",
    "seconds": 2.09,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/e53d7c84ae57e22994.mp3",
    "text": "meminumnya sedikit",
    "seconds": 2.88,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/9058cf4122c836f112.mp3",
    "text": "Nyatakan siapa yang bertindak, kemudian tindakan menolak dan meninggalkan tempat itu.",
    "seconds": 7.44,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/f2fb6ea46083c162af.mp3",
    "text": "Saya menolak minuman itu dan beredar. Beritahu penjaga tentang pelawaan itu.",
    "seconds": 8.14,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/b3bc846b499574a76f.mp3",
    "text": "Soalan 3. Kamu menemui bungkusan yang tidak dikenali.",
    "seconds": 6.84,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/4004aada7f14ae3247.mp3",
    "text": "menjauhkan diri",
    "seconds": 2.78,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/db129ce0e44380ee5d.mp3",
    "text": "membuka bungkusan itu",
    "seconds": 3.19,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/bb29d1cff5c1613625.mp3",
    "text": "Mulakan dengan diri kamu. Pilih frasa yang menjauhkan kamu daripada bungkusan.",
    "seconds": 8.18,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/2d8e990a139c2cd2d7.mp3",
    "text": "Saya menjauhkan diri dan memberitahu guru. Jangan sentuh bungkusan; kandungannya tidak diketahui.",
    "seconds": 9.89,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/3a0b7f716ef8c85955.mp3",
    "text": "Soalan 4. Rakan mahu mencuba bahan yang tidak dikenali.",
    "seconds": 6.89,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/5fc8714a7c75331320.mp3",
    "text": "menasihati rakan",
    "seconds": 2.95,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/8075306c29e2d9dc04.mp3",
    "text": "supaya",
    "seconds": 2.26,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/f25abe859947311ed5.mp3",
    "text": "tidak mencubanya.",
    "seconds": 2.64,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/7258780553c686f759.mp3",
    "text": "mencubanya bersama-sama",
    "seconds": 3.29,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/9bb4e9f30d5a3b803b.mp3",
    "text": "Susun siapa yang bertindak, tindakan menasihati, kemudian tujuan nasihat itu.",
    "seconds": 7.75,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/14659aeed87c422d34.mp3",
    "text": "Saya menasihati rakan supaya tidak mencubanya. Dapatkan juga bantuan guru atau penjaga yang dipercayai.",
    "seconds": 10.22,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/31912e694f8e941cba.mp3",
    "text": "Bergerak di pulau. Tekan laluan untuk berjalan. Kamu juga boleh menggunakan anak panah, W, A, S, D atau butang arah. Seret peta untuk melihat kawasan lain; tekan Cari Watak untuk kembali.",
    "seconds": 20.54,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/d8b3b7a145e4d2bdaf.mp3",
    "text": "Masuk stesen. Tekan bangunan stesen, kemudian dekati pintunya dan tekan Masuk Stesen. Objek tambahan boleh disiasat jika kamu mahu.",
    "seconds": 13.78,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/e85cc067239e87e683.mp3",
    "text": "Jawab tiga jenis aktiviti. Di stesen pertama, pilih A, B atau C. Di stesen kedua, seret kad ke sasaran atau tekan kad kemudian sasaran. Di stesen ketiga, susun frasa menjadi ayat tindakan selamat.",
    "seconds": 21.46,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/e119daf57f45f1d18e.mp3",
    "text": "Kumpulkan tiga digit. Selesaikan empat soalan setiap stesen untuk mendapat satu digit. Buku Kod menyimpannya mengikut ruang pertama, kedua dan ketiga.",
    "seconds": 14.26,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/21cb36599ac4f43759.mp3",
    "text": "Buka peti harta. Pergi ke halaman rumah api selepas tiga stesen selesai. Masukkan tiga digit daripada Buku Kod untuk membuka peti dan melihat sijil.",
    "seconds": 14.09,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/df43530caf8064ee71.mp3",
    "text": "Ini contoh tanpa markah. Pilih warna langit pada hari cerah, kemudian tekan Semak Jawapan.",
    "seconds": 9.36,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/f1e3f765f60c4417c3.mp3",
    "text": "Biru",
    "seconds": 1.97,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/8785c15ca1dec8f70e.mp3",
    "text": "Merah",
    "seconds": 1.92,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/75186c23266f778dab.mp3",
    "text": "Hitam",
    "seconds": 2.14,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/36fc38431cc031340f.mp3",
    "text": "Ini contoh tanpa markah. Seret kad matahari ke sasaran Siang. Kamu juga boleh tekan kad, kemudian tekan sasaran.",
    "seconds": 12.67,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/6c360a3a1d168b19bf.mp3",
    "text": "Matahari",
    "seconds": 2.35,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/ebbb89739acd5ccfa0.mp3",
    "text": "Siang",
    "seconds": 2.21,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/60f0dc23c2a0d29f77.mp3",
    "text": "Ini contoh tanpa markah. Tekan Saya, kemudian suka belajar. Kamu juga boleh menyeret frasa ke ruang ayat.",
    "seconds": 11.83,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/51e9fb6d8da64aafa0.mp3",
    "text": "suka belajar.",
    "seconds": 2.59,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/add51d821c6f7dc2c6.mp3",
    "text": "Rumah Api Selamat kehilangan cahaya. Bantu Hud, Izz dan Aini menyelesaikan tiga stesen dan membuka peti harta karun.",
    "seconds": 11.78,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/0d3af709162702a729.mp3",
    "text": "Jambatan sudah dipulihkan! Digit pertama ialah empat; mari ke bengkel bukti bersama Izz.",
    "seconds": 9.46,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/859f550aea951e3448.mp3",
    "text": "Laluan ke menara sudah dibuka! Digit kedua ialah tujuh; Aini menunggu untuk berlatih tindakan selamat.",
    "seconds": 9.94,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/bee61de61f4eee532c.mp3",
    "text": "Rumah api kembali bercahaya! Digit ketiga ialah dua; pasukan boleh menuju ke peti harta karun.",
    "seconds": 9.96,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/146f696c4cf62abbb2.mp3",
    "text": "Mari fikir semula. Gunakan petunjuk dan cuba lagi.",
    "seconds": 6.55,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/230e10512fade96aba.mp3",
    "text": "Syabas! Jawapan kamu tepat.",
    "seconds": 4.9,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/36f2118b1ec972cd06.mp3",
    "text": "Padankan semua kad dengan sasaran. Seret kad atau tekan kad kemudian tekan sasaran, lalu tekan Semak Jawapan.",
    "seconds": 11.14,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/b189741d5eadabcb85.mp3",
    "text": "Pilih empat frasa yang sesuai dan susun menjadi satu ayat tindakan selamat. Satu frasa tidak diperlukan. Tekan Semak Jawapan apabila siap.",
    "seconds": 13.92,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/b75728c6736bb661c4.mp3",
    "text": "Lihat tiga ruang dalam Buku Kod. Masukkan digit pertama, kedua dan ketiga untuk membuka peti.",
    "seconds": 9.19,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/cf0a3b0413739f5b75.mp3",
    "text": "Semak tiga ruang Kod Harta Karun dalam Buku Kod dan cuba lagi.",
    "seconds": 5.59,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/d4fbea7c7f1c42e294.mp3",
    "text": "Latihan tanpa markah. Tekan bulatan bercahaya untuk bergerak, kemudian tekan Siasat apabila dekat.",
    "seconds": 9.7,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/b5b180fc5d569c0983.mp3",
    "text": "Bagus! Kamu sudah bergerak dan menyiasat. Sekarang pergi ke Kem Detektif untuk Stesen Pertama.",
    "seconds": 10.54,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/6692495ea3113ec878.mp3",
    "text": "Kamu sudah mengenali tembakau, alkohol dan dadah terlarang. Kamu boleh memadankan maklumat dan membina ayat tindakan selamat. Katakan TIDAK, beredar ke tempat selamat dan beritahu orang dewasa yang dipercayai.",
    "seconds": 18.96,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/703457e2a3a3a3018b.mp3",
    "text": "Peti harta karun sudah terbuka! Kamu memperoleh Lencana Wira Pulau Selamat dan sijil pencapaian.",
    "seconds": 9.84,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/7ed9e2982314944063.mp3",
    "text": "Simbol rokok bergaris merah bermaksud dilarang merokok. Pilih kawasan berudara bersih.",
    "seconds": 8.69,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/3c029b48bca427c9fc.mp3",
    "text": "Tembakau, alkohol dan dadah ialah bahan ketagihan. Jauhi bahan ini dan dapatkan bantuan orang dewasa jika tidak pasti.",
    "seconds": 11.54,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/818048c34a310b3045.mp3",
    "text": "Ubat digunakan mengikut arahan doktor atau penjaga yang bertanggungjawab. Jangan mengambil ubat orang lain.",
    "seconds": 9.74,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/dce344ac4d5bc067ea.mp3",
    "text": "Jika menemui bungkusan tidak dikenali, jangan sentuh. Jauhkan diri dan beritahu guru atau penjaga.",
    "seconds": 10.22,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/7ed02352c3d9b59088.mp3",
    "text": "Ubat hanya diambil mengikut arahan doktor atau orang dewasa yang bertanggungjawab. Bungkusan tidak dikenali tidak semestinya mengandungi dadah.",
    "seconds": 11.71,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/06fde91eb92f3a5edb.mp3",
    "text": "Digit pertama ialah empat.",
    "seconds": 3.22,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/522f9b61e7aac7fce5.mp3",
    "text": "Digit kedua ialah tujuh.",
    "seconds": 3.26,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  },
  {
    "file": "assets/audio/ms-MY/21ae63a7898d95dac8.mp3",
    "text": "Digit ketiga ialah dua.",
    "seconds": 3.34,
    "voice": "ms-MY-YasminNeural",
    "language": "ms-MY"
  }
]